# Shell scripts must stay LF - CRLF breaks bash on Linux/macOS
*.sh text eol=lf
*.command text eol=lf

# NOTE: the large world-map binaries (*.pmtiles, regions-seed.geojson,
# cities-seed.json, the default scenario's regions.geojson) used to be tracked in
# Git LFS. They are no longer in the repo at all - they are hosted as GitHub
# Release assets and downloaded by scripts/fetch-map-assets.mjs, because LFS's
# free bandwidth (1 GB/mo, org-wide) could not cover player installs. Do not
# re-add them to LFS. See scripts/map-assets.json.

# Every default prompt passage any version has shipped
# (scripts/prompts/record-shipped-guidance.mjs): one fingerprint per line, only
# ever added to. Merging alpha into beta or beta into main keeps both sides'
# lines instead of conflicting, so no branch forgets the other's old defaults.
src/Game/AI/shippedGuidance.js merge=union

# Historical releases pin source and generated byte hashes. Preserve those bytes
# across Windows/Linux checkouts, including upstream licence/notice files.
server/seed/historical/** -text
server/seed/historical/authored-scenarios.mjs text eol=lf
server/seed/historical/ad1200-review.json text eol=lf
server/seed/historical/bc3000-review.json text eol=lf
# Original upstream Markdown hard-break spaces are covered by its pinned hash.
server/seed/historical/sources/hbm-README.md whitespace=-blank-at-eol
scripts/build-historical-scenarios.mjs text eol=lf
